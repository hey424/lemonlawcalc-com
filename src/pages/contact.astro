---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Contact | lemonlawcalc.com';
const description = 'Contact the editorial team at lemonlawcalc.com for corrections, feedback, or questions.';
---
<BaseLayout title={title} description={description}>
  <h1>Contact</h1>
  <p>For corrections, feedback, or questions about the site, email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>.</p>
  <p>We read every message and respond to factual correction reports promptly. We cannot provide legal advice or respond to requests for case-specific analysis — if you need guidance about a lemon law situation, please consult a licensed lemon law attorney. Most offer free case evaluations and take cases on a fee-shifting basis (if you win, the manufacturer pays their fees).</p>
</BaseLayout>
